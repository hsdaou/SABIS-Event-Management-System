# Supabase Configuration (Required for live database, authentication & realtime sync)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Default primary Control Admin email (can also be managed in Supabase authorized_users table)
VITE_DEFAULT_CONTROL_EMAIL=admin@sabis-events.edu

# Optional: Vercel Serverless Email Dispatch (Resend API) for "Send QR to Registered Contact Info" mode
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SABIS Events <events@yourdomain.com>
